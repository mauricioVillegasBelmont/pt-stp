---
import { Icon } from "astro-icon/components";
import './styles.css';

export interface Props {
  label: string;
  type?: 'pill'| 'rounded' | 'box';
  variant?: 'default' | 'success' | 'warning' | 'error' | 'info';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconPosition?: "left"| "right";
  classes?: string;
  [key: string]: any;
}

const { label, type="rounded", variant = 'default', size = 'md', icon,
iconPosition = "left", classes, ...ElementProps } = Astro.props;
---

<span {...ElementProps} class={['badge', `badge-type-${type}`, `badge-${variant}`, `badge-${size}`, `${classes ? classes : ''}`].join(' ')}>
  {label}
  {icon && <Icon name={icon} class={`${iconPosition==='left' ? 'order-first mr-2' : 'order-last ml-2'}`} />
</span>
