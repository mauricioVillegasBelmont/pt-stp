---
import './styles.css';
export interface Props {
  tag?: string;
  classes?: string;
}

const { tag='section', classes} = Astro.props;
const Tag = tag;
---

<Tag class:list={['hero', `${classes ? classes : ''}`]}>
  <div class="hero__content container">
    <div class="order-1 lg:order-2">
      <slot name="image"/>
    </div>
    <div class="Hero__contentWrapper order-2 lg:order-1">
      <slot name="content"/>
    </div>
  </div>
</Tag>
